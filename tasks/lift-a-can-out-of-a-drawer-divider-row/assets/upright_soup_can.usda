#usda 1.0
(
    defaultPrim = "Can"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Can" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI"]
)
{
    bool physics:rigidBodyEnabled = true
    float physxRigidBody:angularDamping = 0.05

    def Xform "Upright" (
        prepend references = @https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/Isaac/6.1/Isaac/Props/YCB/Axis_Aligned_Physics/005_tomato_soup_can.usd@
        delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float xformOp:rotateX = 90
        uniform token[] xformOpOrder = ["xformOp:rotateX"]
    }
}
