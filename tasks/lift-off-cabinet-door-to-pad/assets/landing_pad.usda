#usda 1.0
(
    defaultPrim = "Body"
    metersPerUnit = 1
    upAxis = "Z"
)
def Xform "Body" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"])
{
    bool physics:rigidBodyEnabled = true
    bool physics:kinematicEnabled = true
    def Material "Material" (prepend apiSchemas = ["PhysicsMaterialAPI"])
    {
        float physics:staticFriction = 0.8
        float physics:dynamicFriction = 0.6400000000000001
        float physics:restitution = 0
    }
    def Cube "rubber_pad" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"])
    {
        double size = 1
        double3 xformOp:translate = (0, 0, 0)
        double3 xformOp:scale = (0.14, 0.41, 0.004)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        bool physics:collisionEnabled = true
        float physxCollision:contactOffset = 5e-05
        float physxCollision:restOffset = 0
        color3f[] primvars:displayColor = [(0.12, 0.42, 0.19)]
        rel material:binding:physics = </Body/Material>
    }
}
